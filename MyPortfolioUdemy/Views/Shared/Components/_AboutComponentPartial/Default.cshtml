<section id="about" class="s-about target-section">

    <div class="row narrow section-intro has-bottom-sep">
        <div class="col-full text-center">
            @if (ViewBag.AboutTitle is List<string> aboutTitles)
            {
                foreach (var title in aboutTitles)
                {
                    <h3>@title</h3>
                }
            }
            else
            {
                <h3>@ViewBag.AboutTitle</h3>
            }
            <h1>Ben Kimim </h1>
            @if (ViewBag.AboutSubDescription is List<string> subDescriptions)
            {
                foreach (var desc in subDescriptions)
                {
                    <p class="lead">@desc</p>
                }
            }
            else
            {
                <p class="lead">@ViewBag.AboutSubDescription</p>
            }
        </div>
    </div>

    <div class="row about-content">

        <div class="col-six tab-full left">
            <h3>Erkut ÇAKAR!</h3>

            <p>Ben Kimim ?</p>

            @if (ViewBag.Details is List<string> details)
            {
                foreach (var detail in details)
                {
                    <p>@detail</p>
                }
            }
            else
            {
                <p>@ViewBag.Details</p>
            }
        </div>

        @await Component.InvokeAsync("_SkillComponentPartial")

    </div> <!-- end about-content -->

    <div class="row about-content about-content--buttons">

        <div class="col-six tab-full left">
            <a href="#0" class="btn btn--primary full-width">CV'mi İndir</a>
        </div>
        <div class="col-six tab-full right">
            <a href="#0" class="btn full-width">Bana Yaz</a>
        </div>

    </div> <!-- end about-content buttons -->
    @await Component.InvokeAsync("_ExperienceComponentPartial")

</section> <!-- end about -->
